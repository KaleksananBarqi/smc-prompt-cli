# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# Project output
output/

# Editors / IDEs
.vscode/
.idea/

# Logs
*.log

# Provider credentials (never commit API keys/tokens)
.env
.env.*
# ...but the committable template must survive the .env.* glob above. A
# negation cannot re-include a file whose parent directory is excluded, so
# ordering matters: this line must stay AFTER the patterns it overrides.
!.env.example
*.key.txt
secrets.txt

# --- AL / Dynamics 365 Business Central (existing remote config) ---
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml
