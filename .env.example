# =====================================================================
# smc-prompt — contoh kredensial provider
# =====================================================================
# CARA PAKAI
#   1. Salin file ini menjadi .env  ->  copy .env.example .env
#      (Windows cmd:  copy .env.example .env)
#      (PowerShell :  Copy-Item .env.example .env)
#   2. Isi nilai di bawah.
#   3. Jalankan seperti biasa; .env dimuat otomatis oleh CLI.
#
# File .env TIDAK akan ikut ter-commit (lihat .gitignore). File contoh ini
# (`.env.example`) justru memang di-commit sebagai templat — jangan pernah
# menaruh key asli di sini.
#
# PRIORITAS (yang lebih atas menang):
#   flag CLI  >  environment shell  >  file .env
# Jadi variabel yang sudah Anda `export`/`set` di shell TIDAK akan ditimpa
# oleh isi file ini. Gunakan `--no-dotenv` untuk mematikan pemuatan .env
# sepenuhnya, atau `--env-file PATH` untuk memakai file lain.
#
# Baris berawalan '#' adalah komentar. Nilai boleh tanpa tanda kutip.
# Biarkan kosong bila provider tersebut tidak dipakai.
# =====================================================================


# ---------------------------------------------------------------------
# Twelve Data — FX & logam (XAUUSD). 4h native.
# Daftar API key GRATIS di: https://twelvedata.com
# Contoh pemakaian:
#   smc-prompt XAUUSD --provider twelvedata
# ---------------------------------------------------------------------
TWELVEDATA_API_KEY=


# ---------------------------------------------------------------------
# OANDA v20 — FX & logam (XAU_USD). H4 native.
# Ambil token dari portal OANDA. Akun PRACTICE gratis sudah cukup.
# Contoh pemakaian:
#   smc-prompt XAUUSD --provider oanda --oanda-env practice
# ---------------------------------------------------------------------
OANDA_API_TOKEN=

# OPSIONAL. Biarkan kosong: account id ditemukan otomatis dari
# endpoint /v3/accounts saat tidak diisi.
OANDA_ACCOUNT_ID=


# ---------------------------------------------------------------------
# CATATAN
# * Binance (provider default) TIDAK butuh kredensial apa pun.
# * Jangan commit file .env. Jika key tidak sengaja ter-commit, segera
#   rotasi (regenerate) key tersebut di dashboard provider.
# =====================================================================
